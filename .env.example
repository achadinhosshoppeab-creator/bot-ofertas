# Fonte das ofertas: shopee (padrão, 100% automática) ou mercadolivre (só dry-run)
OFFER_SOURCE=shopee
# Open API de Afiliados Shopee (affiliate.shopee.com.br/open_api)
SHOPEE_APP_ID=
SHOPEE_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_ADMIN_CHAT_ID=
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=
# Usado só na primeira vez; depois os tokens renovados ficam em ML_TOKENS_PATH
ML_REFRESH_TOKEN=
# ML_TOKENS_PATH=data/ml-tokens.json
# Link de afiliado: matt_tool (ID) e matt_word (etiqueta) — confira num link gerado no portal
ML_AFFILIATE_ID=
ML_AFFILIATE_TAG=
# Marca usada nas imagens/legendas e quantos carrosséis gerar por `npm run draft`
BRAND_NAME=Achadinhos
DRAFTS_PER_RUN=3
# Pinterest (developers.pinterest.com) — secret só aparece após aprovação do Trial
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Narração dos vídeos (modelo Kokoro via sherpa-onnx). Vazio = vídeo mudo.
# TTS_ENGINE=edge            # edge (padrão, vozes neurais pt-BR) | kokoro | off
# TTS_VOICE=pt-BR-FranciscaNeural
# TTS_RATE=+8%
TTS_MODEL_DIR=../pipeline-scripts/dl/kokoro-multi-lang-v1_0
# TTS_PYTHON=.venv/bin/python
# TTS_SPEAKER_ID=43
# TikTok for Developers (Login Kit + Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=http://localhost:8585/callback
# Página de ofertas (GitHub Pages): clone local e URL pública
SITE_DIR=../achadinhosshoppeab-creator.github.io
SITE_URL=https://achadinhosshoppeab-creator.github.io
# SITE_MAX_OFFERS=200
# SITE_PUSH=true
DRY_RUN=true
# Opcional: caminho do SQLite (padrão: data/bot.db)
# DATABASE_PATH=data/bot.db
# Opcional: agenda no horário de Brasília (padrão: a cada 30 min das 8h às 23h)
# SCHEDULE_CRON=*/15 8-23 * * *
# DRAFTS_CRON=30 7 * * *        # rascunhos diários para TikTok (vazio = desliga)
